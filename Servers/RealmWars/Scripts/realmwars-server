#!/bin/sh
# Start the Realm Wars dedicated server (START_EXE).
#
# - Server settings are applied from lancommander/main.cs, which the game loads as a mod
#   (-mod lancommander) after rw/main.cs has run the server defaults and rw/server/prefs.cs.
#   It is regenerated from the REALMWARS_* variables on every start.
# - The game's console input thread crashes (unhandled page fault right after "Engine
#   initialized...") unless it has a real console, so it runs inside a pseudo-terminal from
#   `script`. The pty output is garbage; console.log is followed to stdout instead.
set -e

# START_ARGS arrive as positional arguments; the game re-splits on whitespace anyway
start_args="$*"

cd "${SERVER_ROOT:-/config/Merged}"

if [ ! -f RealmWars.exe ]; then
    echo "RealmWars.exe not found in $(pwd). Put a Realm Wars install in /config/Server." >&2
    exit 1
fi

if [ ! -f "$REALMWARS_MISSION" ]; then
    echo "Mission $REALMWARS_MISSION not found in $(pwd). Available missions:" >&2
    find . -path '*/missions/*.mis' | sed 's|^\./||' >&2
    exit 1
fi

# TorqueScript string literal contents: escape backslashes and double quotes
ts() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

mkdir -p lancommander
cat > lancommander/main.cs <<EOF
// Generated by realmwars-server from the REALMWARS_* environment variables on every start.
// Put your own startup script in lancommander/custom.cs instead of editing this file.
\$Pref::Server::Name = "$(ts "$REALMWARS_SERVER_NAME")";
\$Pref::Server::Info = "$(ts "$REALMWARS_SERVER_INFO")";
\$Pref::Server::MaxPlayers = "$(ts "$REALMWARS_MAX_PLAYERS")";
\$Pref::Server::Password = "$(ts "$REALMWARS_PASSWORD")";
\$Pref::Server::AdminPassword = "$(ts "$REALMWARS_ADMIN_PASSWORD")";
\$Pref::Server::TimeLimit = "$(ts "$REALMWARS_TIME_LIMIT")";
\$Pref::Server::Port = "$(ts "$REALMWARS_PORT")";

// master.garagegames.com no longer exists
\$Pref::Net::DisplayOnMaster = "Never";

if (isFile("lancommander/custom.cs"))
	exec("lancommander/custom.cs");
EOF

set -- RealmWars.exe -dedicated -mod lancommander -mission "$REALMWARS_MISSION"

# The game re-splits its arguments on whitespace, so these are split here too
# shellcheck disable=SC2086
set -- "$@" $REALMWARS_EXTRA_ARGS $start_args

# Single-quote each argument for the command line `script` hands to sh
cmd="wine-run"
for arg in "$@"; do
    cmd="$cmd '$(printf '%s' "$arg" | sed "s/'/'\\\\''/g")'"
done

echo "Starting: $*"

# console.log is rewritten on every start; -F follows it through the truncation
touch console.log
tail -n 0 -F console.log 2>/dev/null &

exec script -qfec "$cmd" /dev/null </dev/null >/dev/null
