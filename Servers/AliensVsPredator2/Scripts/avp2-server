#!/bin/sh
# Start the Aliens vs. Predator 2 dedicated server (START_EXE).
#
# Runs `AVP2Serv.exe -config <AVP2_CONFIG>` under Wine with Xvfb. AVP2Serv is a GUI app; -config
# loads ServerData\<AVP2_CONFIG>.txt, which the configure hook fills in, and starts hosting
# without any dialog. Its console is a list box in that window, so nothing reaches docker logs;
# check the server with a GameSpy `\status\` query to the game port. Any START_ARGS are appended.
set -e

root="${SERVER_ROOT:-/config/Merged}"
cfg="${AVP2_CONFIG:-lancommander}"

cd "$root"

if [ ! -f AVP2Serv.exe ]; then
    echo "AVP2Serv.exe not found in $root. Put an AvP2 install in /config/Server." >&2
    exit 1
fi

if [ ! -f "ServerData/$cfg.txt" ]; then
    echo "ServerData/$cfg.txt not found in $root; AVP2Serv would open its setup dialog and never start." >&2
    exit 1
fi

set -- -config "$cfg" "$@"

printf 'Starting: AVP2Serv.exe %s\n' "$*"
printf 'Game port and status queries on %s/udp\n' "${AVP2_PORT:-27888}"

export WINE_XVFB="${WINE_XVFB:-true}"
exec wine-run AVP2Serv.exe "$@"
