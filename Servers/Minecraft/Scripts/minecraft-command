#!/bin/sh
# Send a console command to the running server, e.g.
#   docker exec minecraft minecraft-command 'say Hello'
#   docker exec minecraft minecraft-command 'op SomePlayer'
fifo=/run/minecraft/console

if [ $# -eq 0 ]; then
    echo "usage: minecraft-command '<command>'" >&2
    exit 2
fi

if [ ! -p "$fifo" ]; then
    echo "The server isn't running ($fifo not found)" >&2
    exit 1
fi

printf '%s\n' "$*" > "$fifo"
