+// Account fields end up in the \f separated database files and as directory names.
+static bool validAccountField(const string& value)
+{
+	for(size_t i = 0; i < value.size(); i++)
+		if((unsigned char)value[i] < 0x20 || value[i] == 0x7f)
+			return false;
+	return true;
+}
+
+// Failed logins per IP address: after 10 within 10 minutes the address cannot log in until the window has passed.
+static map<string, pair<time_t, int> > loginFailures;
+
+static bool loginBlocked(const char* ip)
+{
+	map<string, pair<time_t, int> >::iterator it = loginFailures.find(ip);
+	if(it == loginFailures.end())
+		return false;
+	if(time(NULL) - it->second.first > 600)
+	{
+		loginFailures.erase(it);
+		return false;
+	}
+	return it->second.second >= 10;
+}
+
+static void loginFailed(const char* ip)
+{
+	if(loginFailures.size() > 100000)
+		loginFailures.clear();
+	pair<time_t, int>& entry = loginFailures[ip];
+	if(entry.second == 0 || time(NULL) - entry.first > 600)
+		entry = make_pair(time(NULL), 0);
+	entry.second++;
+}
+
+bool GameClient::allows(const char* type, const string& txn)
+{
+	bool account = strcmp(type, "acct") == 0;
+	if(account && (txn == "GetCountryList" || txn == "NuGetTos" || txn == "NuAddAccount"))
+		return true;
+	if(account && txn == "NuLogin")
+		return !loggedIn;
+	if(!loggedIn)
+		return false;
+	// persona selection and account calls come before NuLoginPersona, everything else needs a persona
+	return account || (persona.data != NULL && persona.id > 0);
+}
