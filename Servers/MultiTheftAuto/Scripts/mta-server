#!/bin/sh
# Start the Multi Theft Auto server (START_EXE):
#   ./mta-server64 -n -u -t <START_ARGS>
# from the server root, so everything it writes (logs, databases, resource cache, settings.xml)
# lands in Overlay/. -n: no ncurses, -u: unbuffered output, -t: plain console, so the output
# reads well in docker logs. Port, players and the rest come from mods/deathmatch/mtaserver.conf
# (see the 30-ConfigureMultiTheftAuto hook).
#
# The console's input is the FIFO /run/mta/console, which `mta-command '<command>'` writes to
# (e.g. from `docker exec`), plus the container's stdin when one is attached. This script keeps the
# FIFO open, so the server waits for input instead of reading end-of-file. A SIGTERM or SIGINT
# that reaches this script is turned into `shutdown`, like the 50-ConsoleAndStopSignal hook does
# for `docker stop`.
set -e

root="${SERVER_ROOT:-/config/Merged}"
cd "$root"

if [ ! -x ./mta-server64 ]; then
    echo "mta-server64 not found in $root; see the 20-InstallMultiTheftAuto errors above" >&2
    exit 1
fi

dir=/run/mta
fifo="$dir/console"
mkdir -p "$dir" 2>/dev/null || true
rm -f "$fifo"
mkfifo -m 600 "$fifo"

# Keep the real stdin before the background jobs below get /dev/null for theirs
exec 4<&0

stopping=
shutdown() {
    if [ -z "$stopping" ]; then
        stopping=1
        echo "Stopping: shutdown"
        printf 'shutdown\n' >&3 2>/dev/null || true
    fi
}
trap shutdown TERM INT

set -- ./mta-server64 -n -u -t "$@"
echo "Starting: $*"

set +e

# Opening the FIFO for reading waits for the first writer, which is fd 3 below
"$@" < "$fifo" &
server=$!
exec 3> "$fifo"

feeder=
if [ "$(readlink /proc/self/fd/4)" != /dev/null ]; then
    cat <&4 >&3 &
    feeder=$!
fi
exec 4<&-

# A trapped signal interrupts wait; keep waiting for the server to exit
status=0
while kill -0 "$server" 2>/dev/null; do
    wait "$server"
    status=$?
done

[ -n "$feeder" ] && kill "$feeder" 2>/dev/null
exec 3>&-
rm -f "$fifo"
exit $status
