#!/bin/sh
# Send a console command to the running server, e.g.
#   docker exec mta mta-command 'say Hello'
#   docker exec mta mta-command 'skipmap'
#   docker exec mta mta-command 'start freeroam'
fifo=/run/mta/console

if [ $# -eq 0 ]; then
    echo "usage: mta-command '<command>'" >&2
    exit 2
fi

if [ ! -p "$fifo" ]; then
    echo "The server isn't running ($fifo not found)" >&2
    exit 1
fi

printf '%s\n' "$*" > "$fifo"
