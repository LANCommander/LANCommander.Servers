#!/bin/sh
# Start the Double Action: Boogaloo dedicated server (START_EXE).
#
# Runs the Windows srcds.exe under Wine (wine-run, with Xvfb: srcds -console needs a window for
# its console). START_ARGS come right after the fixed srcds arguments; the DAB_* settings are
# applied as described below.
# srcds's console window isn't visible under Wine, so -condebug writes the console log and that
# file is followed to stdout for `docker logs`. DAB's write path is da_info/, not dab/.
set -e

cd "${SERVER_ROOT:-/config/Merged}"

if [ ! -f srcds.exe ] || [ ! -f dab/bin/server.dll ]; then
    echo "srcds.exe or dab/bin/server.dll not found in $(pwd); the install hook did not finish." >&2
    exit 1
fi

# The stock dab/cfg/server.cfg runs on every map load and sets hostname and sv_lan 0, which would
# override command-line cvars. So the DAB_* cvars go into a generated cfg/lancommander.cfg, used as
# servercfgfile: it runs DAB_SERVER_CFG first and then applies the DAB_* values.
cfg_quote() { printf '%s' "$1" | tr -d '"'; }

mkdir -p dab/cfg
{
    echo "// Generated by dab-server on every start. Edits are overwritten; use DAB_* or your own cfg."
    [ -z "$DAB_SERVER_CFG" ]    || echo "exec \"$(cfg_quote "$DAB_SERVER_CFG")\""
    [ -z "$DAB_HOSTNAME" ]      || echo "hostname \"$(cfg_quote "$DAB_HOSTNAME")\""
    echo "sv_lan \"$(cfg_quote "${DAB_LAN:-1}")\""
    echo "sv_password \"$(cfg_quote "$DAB_PASSWORD")\""
    [ -z "$DAB_RCON_PASSWORD" ] || echo "rcon_password \"$(cfg_quote "$DAB_RCON_PASSWORD")\""
} > dab/cfg/lancommander.cfg

set -- -console -game dab -condebug \
    -port "${DAB_PORT:-27015}" \
    +maxplayers "${DAB_MAX_PLAYERS:-16}" \
    "$@"

# DAB_EXTRA_ARGS is split on whitespace
# shellcheck disable=SC2086
[ -z "$DAB_EXTRA_ARGS" ] || set -- "$@" $DAB_EXTRA_ARGS

set -- "$@" +servercfgfile lancommander.cfg +map "${DAB_MAP:-da_cocaine}"

# Passwords are only in lancommander.cfg, not on the command line
echo "Starting: srcds.exe $*"

# console.log is appended to on every start; only show new lines
mkdir -p da_info
touch da_info/console.log
tail -n 0 -F da_info/console.log 2>/dev/null &

exec wine-run srcds.exe "$@"
