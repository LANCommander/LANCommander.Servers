[UpdateServerCommandlet]
HelpCmd=updateserver
HelpOneLiner=Auf Auto-Update-Anfragen der Unreal Engine reagieren.
HelpUsage=updateserver [-Option ...] [Param=Wert] ...
HelpParm[0]=ConfigFile
HelpDesc[0]=Configuration file to use.  Default: UpdateServer.ini

[MasterServerCommandlet]
HelpCmd=masterserver
HelpOneLiner=Eine Masterliste von Servern unterhalten.
HelpUsage=masterserver [-Option ...] [Param=Wert] ...
HelpParm[0]=ConfigFile
HelpDesc[0]=Configuration file to use.  Default: MasterServer.ini

[CompressCommandlet]
HelpCmd=compress
HelpOneLiner=Ein Unreal-Paket für den Auto-Download komprimieren. Es wird eine Datei mit der Namenerweiterung .uz erzeugt.
HelpUsage=compress Datei1 [Datei2 [Datei3 ...]]
HelpParm[0]=Files
HelpDesc[0]=The wildcard or file names to compress.

[DecompressCommandlet]
HelpCmd=decompress
HelpOneLiner=Eine mit "ucc compress" komprimierte Datei dekomprimieren.
HelpUsage=decompress KomprimierteDatei
HelpParm[0]=CompressedFile
HelpDesc[0]=The .uz file to decompress.

