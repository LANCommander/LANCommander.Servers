#!/bin/sh
# Send a console command to the running MHServerEmu, e.g.
#   docker exec marvelheroes mhserveremu-command '!server shutdown'
#   docker exec marvelheroes mhserveremu-command '!account userlevel me@example.com 2'
fifo=/run/mhserveremu/console

if [ $# -eq 0 ]; then
    echo "usage: mhserveremu-command '<command>'" >&2
    exit 2
fi

if [ ! -p "$fifo" ]; then
    echo "MHServerEmu isn't running ($fifo not found)" >&2
    exit 1
fi

printf '%s\n' "$*" > "$fifo"
